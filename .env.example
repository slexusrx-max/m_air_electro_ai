# Technical activation is separate from owner-confirmed program approval.
# Keep link maps empty until real issued links are verified. Both legacy flags remain required.
RENOGY_AFFILIATE_APPROVED=false
AFFILIATE_TRACKING_ENABLED=false
RENOGY_IMPACT_LINKS_JSON={}
# Owner-confirmed approval 2026-10-14; IDs alone never activate tracking.
RENOGY_IMPACT_PROGRAM_ID=14864
# Enable only after recording eligible EU domains/territories and actual issued links.
RENOGY_IMPACT_EU_VERIFIED=false
# Exact HTTPS origins copied from the issued links; empty fails closed. No guessed hosts.
RENOGY_IMPACT_VERIFIED_ORIGINS_JSON=[]
# Waterdrop Europe is approved separately in Impact. Tracking remains fail-closed
# until the global flag is true and every ordinary product URL has an exact
# network-issued HTTPS destination in the JSON map.
WATERDROP_AFFILIATE_APPROVED=false
WATERDROP_IMPACT_PROGRAM_ID=
WATERDROP_IMPACT_LINKS_JSON={}
# Verified inbound contact routing only; this does not enable outbound or form delivery.
CONTACT_EMAIL_VERIFIED=true
# Owner/publisher identity is owner-confirmed in lib/site.ts, not a company env override.
AMAZON_ASSOCIATE_ID=
EBAY_CAMPAIGN_ID=
# Publisher identity: real, owner-confirmed information only. Rebuild after public env changes.
NEXT_PUBLIC_EDITOR_NAME=
NEXT_PUBLIC_EDITOR_BIO=
NEXT_PUBLIC_EDITOR_EXPERTISE=
NEXT_PUBLIC_EDITOR_PROFILE=
NEXT_PUBLIC_PARTNERSHIPS_EMAIL=partnerships@mairelectroai.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@mairelectroai.com
# Safe local/template default, not the authoritative Production state.
# Configure Brevo and Turnstile first; enable for an authorized receipt test.
# Record provider acceptance and inbox receipt separately in the readiness report.
CONTACT_FORM_ENABLED=false
CONTACT_FROM_EMAIL=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional Plausible site hostname. No tracking until visitor opts in; leave blank during QA.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
